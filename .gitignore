# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — never committed; .env.example is the only tracked template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state (created by `supabase link`/`supabase start`,
# machine-specific — never something to share across clones)
supabase/.branches
supabase/.temp

# editor/IDE — personal, not project config
.vscode/
.idea/
*.swp

# Claude Code — project-level settings.json (if any) is intentionally
# tracked for the team; only the personal local-override file is not
.claude/settings.local.json

# playwright
/test-results/
/playwright-report/
/blob-report/

# Supabase project settings → API. Safe to expose to the browser (RLS is
# what actually protects the data, not secrecy of these two values).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, never prefixed with NEXT_PUBLIC_. Used
# exclusively by scripts/seed.ts to create the two auth users. Never import
# this in app code that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# scripts/seed.ts reads these to create/update the two accounts. Change the
# passwords after first login; the script is idempotent and safe to re-run.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-owner
SEED_OWNER_NAME="Me"

SEED_PARTNER_EMAIL=partner@example.com
SEED_PARTNER_PASSWORD=change-me-partner
SEED_PARTNER_NAME="Partner"
